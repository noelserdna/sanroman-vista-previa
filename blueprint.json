{
 "$schema": "https://playground.wordpress.net/blueprint-schema.json",
 "landingPage": "/",
 "preferredVersions": {
  "php": "8.3",
  "wp": "latest"
 },
 "features": {
  "networking": true
 },
 "login": false,
 "steps": [
  {
   "step": "setSiteLanguage",
   "language": "es_ES"
  },
  {
   "step": "installTheme",
   "themeData": {
    "resource": "url",
    "url": "https://raw.githubusercontent.com/noelserdna/sanroman-vista-previa/e5819bca5766cf98e390390c81cd5d2775205f39/sanroman.zip"
   },
   "options": {
    "activate": true
   }
  },
  {
   "step": "unzip",
   "zipFile": {
    "resource": "url",
    "url": "https://raw.githubusercontent.com/noelserdna/sanroman-vista-previa/e5819bca5766cf98e390390c81cd5d2775205f39/contenido.zip"
   },
   "extractToPath": "/wordpress"
  },
  {
   "step": "mkdir",
   "path": "/wordpress/wp-content/mu-plugins"
  },
  {
   "step": "cp",
   "fromPath": "/wordpress/contenido/aviso-vista-previa.php",
   "toPath": "/wordpress/wp-content/mu-plugins/aviso-vista-previa.php"
  },
  {
   "step": "runPHP",
   "code": "<?php require '/wordpress/contenido/crear-paginas.php';"
  }
 ]
}